# =============================================================================
# India Market Entry & Strategic Growth Intelligence - Environment Configuration
# =============================================================================

# Primary Database (PostgreSQL recommended for production)
# When Docker Compose is running:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/india_market_entry
# For zero-setup local development without PostgreSQL running, leave unset or use SQLite:
DATABASE_URL=sqlite:///./data/india_market_entry.db

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:8000/api
