{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build && rm -rf ../public && cp -r dist ../public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{backend/.venv/**,backend/tests/**,backend/.pytest_cache/**,backend/data/**,frontend/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|docs|openapi\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
